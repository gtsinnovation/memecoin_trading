# signer_service/.env.example
#
# Secrets for the SIGNER service only. This is intentionally a separate
# .env from the project root's -- the main "web" app must never see these
# values (see main.py's module docstring and STAGE3_SETUP.md for why).
#
#   cp signer_service/.env.example signer_service/.env
#
# docker-compose.yml is wired to load this into the "signer" service only.
# Never commit your real signer_service/.env file.

# --- Turnkey (see STAGE3_SETUP.md for how to get each of these) ---------
#
# Your Turnkey organization ID, from the Turnkey dashboard.
TURNKEY_ORGANIZATION_ID=

# Your Turnkey API key pair. Generated in the Turnkey dashboard (or via
# their CLI) -- TURNKEY_API_PRIVATE_KEY never leaves your control and is
# never sent to Turnkey itself; it's used locally to sign (stamp) each
# request. Treat it exactly like a private key, because it is one -- it
# doesn't hold funds, but anyone who has it can direct Turnkey to sign
# transactions on your organization's behalf (within whatever policies
# you've configured).
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=

# The Solana address of the wallet ACCOUNT you created inside your
# Turnkey org (not the org ID, not the API key -- a base58 Solana pubkey,
# e.g. 9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM). This is the address
# that will sign and pay fees for every transaction this service submits.
TURNKEY_SOLANA_WALLET_ADDRESS=

# --- Solana network ---------------------------------------------------
#
# Devnet by default -- Stage 3 only ever executes on devnet (see
# README.md and STAGE3_SETUP.md). Do not point this at a mainnet RPC
# unless you have read Stage 4's (not-yet-built) documentation and mean
# it -- SIGNER_MODE below is a second, independent gate, but don't rely
# on gates instead of paying attention to what you're configuring.
SOLANA_RPC_URL=https://api.devnet.solana.com

# --- What /execute actually does ---------------------------------------
#
# "devnet_transfer_test" is the only implemented mode: signs and
# broadcasts a tiny SELF-transfer of devnet SOL to prove the
# custody+signing+broadcast plumbing works. It does not buy any token --
# see main.py's module docstring for why. "mainnet_jupiter_swap" exists
# as a named placeholder for Stage 4 and is refused if set (not
# implemented yet).
SIGNER_MODE=devnet_transfer_test

# How many lamports the devnet self-transfer test moves. 1000 lamports =
# 0.000001 SOL -- large enough to be a real, findable transaction on a
# block explorer, small enough that the amount is obviously not "a trade."
DEVNET_TEST_TRANSFER_LAMPORTS=1000

# --- Policy (layer 2 of 3 -- see policy_guard.py's docstring) ----------
#
# REQUIRED. Comma-separated Solana token mint addresses this signer is
# willing to execute against AT ALL, independent of what the main
# pipeline's own WATCHLIST_TOKEN_ADDRESSES contains -- deliberately a
# second, separate allowlist you configure explicitly, so "the pipeline
# is allowed to look at this token's data" and "the signer is allowed to
# actually execute for this token" are two different decisions. Empty by
# default -- every request is refused until you set this.
ALLOWED_EXECUTION_TOKENS=

# REQUIRED. Maximum USD size (as reported by the pipeline's own sizing,
# which this service takes at face value for this ONE check -- the
# capital-cap check below is independent) this signer will act on in a
# single request. Refuses (does not clamp) anything larger. Zero/unset
# means every request is refused.
MAX_TRADE_USD=0

# REQUIRED. Orders this signer will reserve in any rolling 24 hours. Counted
# from its own order ledger (signer_orders) AND from its own memory, so a
# database edit cannot reset it. Zero/unset refuses everything.
SIGNER_MAX_ORDERS_PER_DAY=0

# Total USD deployed across open positions, INCLUDING this order. The
# dashboard's max_total_capital_usd can only TIGHTEN this, never raise it:
# a limit the web app could lift is not a limit against the web app.
# Optional on devnet; REQUIRED (non-zero) in any real-funds mode.
SIGNER_MAX_TOTAL_DEPLOYED_USD=0

# USD this signer will sign in any rolling 24 hours. Optional on devnet;
# REQUIRED in any real-funds mode.
SIGNER_MAX_DAILY_USD=0

# REQUIRED. HMAC key authenticating the web app (signer_auth.py). EXACTLY the
# same value as SIGNER_SHARED_SECRET in the project-root .env; at least 32
# characters -- generate with `openssl rand -hex 32` (STAGE3_SETUP.md Part 3
# has a PowerShell equivalent). Unset or short refuses every request.
SIGNER_SHARED_SECRET=

# --- Database (policy re-validation + audit log -- see policy_guard.py) -
#
# Same Postgres the main app uses. Mostly reads (run_status, the capital
# cap, currently-deployed capital) but it also APPENDS to
# execution_audit_log -- so a strictly read-only role will break the audit
# trail. Part 2b of STAGE3_SETUP.md has a least-privilege role that grants
# exactly SELECT on two tables plus INSERT on the audit log.
#
# THE PASSWORD BELOW IS A DEFAULT AND IS PROBABLY WRONG FOR YOU.
# docker-compose.yml builds the WEB service's DATABASE_URL by substituting
# ${POSTGRES_PASSWORD} from the project root's .env. This file is loaded
# via compose's `env_file:`, which does NOT do that substitution -- every
# value here is passed through literally. So:
#
#   - Writing ${POSTGRES_PASSWORD} here does NOT work. It arrives as the
#     literal seven-character string "${POSTGRES_PASSWORD}".
#   - Put the actual password in, spelled out.
#   - If it contains @ : / ? # or %, percent-encode those (@ -> %40,
#     : -> %3A, / -> %2F, # -> %23, % -> %25) or the URL parses wrong.
#
# Symptom if you get this wrong: /whoami still PASSES (it never touches
# the database) and /execute returns a 500. Nothing unsafe happens --
# policy_guard fails closed -- but the error points at the wrong place.
DATABASE_URL=postgresql://signer_svc:REPLACE_WITH_THE_SIGNER_ROLE_PASSWORD@db:5432/memecoin_trading

# Which network the audit log records, and what the startup check enforces.
#
# Leave UNSET for the public endpoints -- the network is read from the RPC
# URL's HOST. Set it explicitly only for a private provider whose hostname
# does not say which network it serves.
#
# It is read from the host and NEVER from the path or query string, because
# those carry API keys: "https://mainnet.helius-rpc.com/?api-key=8f3devnet91"
# contains the substring "devnet" and used to be labelled devnet in the one
# column an auditor reads to answer "did real money move".
#
# Valid values: devnet, testnet, mainnet.
# SOLANA_NETWORK=

# Startup REFUSES to run if SIGNER_MODE=devnet_transfer_test and the resolved
# network is not devnet. That mode signs and broadcasts a real transfer, and
# nothing else in the code was stopping it from doing so on mainnet. The
# authoritative check is the RPC's GENESIS HASH (asked of the chain itself,
# not read from the hostname): nothing is signed until it says devnet.
