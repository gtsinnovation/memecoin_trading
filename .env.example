# .env.example
#
# Copy this file to ".env" (same folder as docker-compose.yml) and fill in
# real values. docker-compose automatically loads ".env" and substitutes
# ${VAR} references in docker-compose.yml -- you do not need to export these
# yourself or pass them on the command line.
#
#   cp .env.example .env
#   docker compose up --build
#
# Never commit your real ".env" file.

# --- Sign-in (feature 8: user authentication) --------------------------------
#
# This is a simple Gmail-address login gate, NOT real Google OAuth: when
# someone opens the dashboard, they are prompted to type a Gmail address, and
# are signed in if it exactly matches the value below. There is no Google
# handshake and nothing verifies the visitor actually owns that Gmail account
# -- so treat this address itself as a shared secret (don't publish it
# anywhere public), since anyone who knows or guesses it can sign in.
AUTHORIZED_GOOGLE_EMAIL=you@example.com

# Random secret used to sign session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If you leave this unset, the app will generate a temporary one at startup
# (and log a warning) -- every server restart will then invalidate all
# sessions and force you to sign in again.
# Set to 1 ONLY for local http://localhost testing. The session cookie is
# marked Secure by default, and a Secure cookie is not sent over plain HTTP --
# so without this you cannot sign in locally. Never set it on a deployed host.
SESSION_COOKIE_INSECURE=

# Session lifetime in seconds (default 12h).
SESSION_MAX_AGE_SECONDS=

SESSION_SECRET_KEY=

# --- Database ------------------------------------------------------------
#
# Postgres password, shared by the "db" and "web" services below (both read
# this same variable, so they always stay in sync). Defaults to "secret" if
# left unset, which is fine for local testing but must be changed before
# this is ever reachable from outside your own machine -- see DEPLOYMENT.md.
# Generate a real one with:
#   openssl rand -hex 24
# IMPORTANT: use openssl/token_hex (hex characters only) and not a generator
# that can produce a "$" character -- docker compose treats "$" specially
# when substituting variables from this file, and a stray "$" in the value
# will silently truncate/corrupt the password instead of erroring loudly.
POSTGRES_PASSWORD=

# --- Real Solana market data (Stage 1 of DEX/wallet integration) ---------
#
# See README.md for the full picture. This stage replaces the pipeline's
# random/simulated price, liquidity, volume, holder-concentration, and
# slippage numbers with real ones fetched from public Solana data sources.
# It does NOT touch a wallet, sign anything, or place a trade -- there is
# still no private key or execution logic anywhere in this app.

# REQUIRED. Comma-separated list of Solana token mint addresses for the
# pipeline to evaluate each tick, e.g.:
#   WATCHLIST_TOKEN_ADDRESSES=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v,So11111111111111111111111111111111111111112
# We deliberately do NOT ship a default watchlist -- a stale or wrong
# address baked into the code would be worse than a clear startup warning.
# Find current, real addresses via a block explorer (solscan.io,
# birdeye.so) or DexScreener's own site (dexscreener.com/solana) -- never
# trust an address pasted in a chat, DM, or comment section; memecoin
# scams frequently impersonate legitimate tokens with lookalike addresses.
WATCHLIST_TOKEN_ADDRESSES=

# Solana JSON-RPC endpoint used for holder-concentration lookups. The
# public default below works for light testing but is explicitly NOT
# meant for production use (Solana's own docs say so) and will throttle
# under load. For anything beyond quick testing, get a free API key from
# a provider such as Helius (helius.dev) and set this to the URL they
# give you instead.
# A paid RPC endpoint. Use the PLAIN HOSTNAME here, e.g.
#   SOLANA_RPC_URL=https://<your-name>.rpcpool.com
# and put the credential in SOLANA_RPC_X_TOKEN below. Do NOT use a path-style
# URL with the token embedded: this value is printed verbatim in at least one
# error message and would end up in logs and alert rows.
SOLANA_RPC_URL=https://api.mainnet.solana.com

# DexScreener (price/liquidity/volume) and Jupiter (slippage estimate)
# public API bases. Free, no key required. Only override these if you
# have a reason to point at a different host (e.g. a proxy).
DEXSCREENER_API_BASE=https://api.dexscreener.com
JUPITER_API_BASE=https://api.jup.ag

# Hypothetical trade size (USD) used to probe Jupiter for an estimated
# slippage/price-impact percentage. Not the pipeline's real position size
# (that's computed separately, per-token) -- just needs to be roughly the
# scale of a real trade.
SLIPPAGE_PROBE_USD=500

# OPTIONAL. There is currently no good free data source for social/hype
# volume -- LunarCrush is the standard provider but dropped its free tier.
# Leave this unset and social_volume_score will be a clearly-labeled
# placeholder (with a warning logged every time it's used), not real
# data. Only set this if you've signed up for a LunarCrush plan yourself.
# (The "gmgn" provider below offers a partial alternative -- see below.)
LUNARCRUSH_API_KEY=

# --- Market-data provider ------------------------------------------------
#
# Whichever provider is selected, this app only ever READS market data.
# None of them involves a wallet, a signing key, a deposit, or any custody
# relationship -- execution lives solely in the separate signer service
# (see STAGE3_SETUP.md).
#
# "free"        RECOMMENDED. DexScreener + RugCheck + Jupiter. No API key
#               of any kind. The only provider that supplies rug/security
#               signals (holder concentration, rug score, mint/freeze
#               authority status) and token age.
# "dexscreener" The original path: DexScreener + a Solana RPC holder
#               lookup against an endpoint Solana says isn't for production.
# "gmgn"        Effectively unusable: GMGN's API is behind Cloudflare bot
#               management that refuses plain Python clients, and their docs
#               cap it at ~1 req/sec with no HA guarantee. Kept only in case
#               their access model changes.
MARKET_DATA_PROVIDER=free

# --- Holder concentration -------------------------------------------------
#
# F_ATLAS refuses a token whose top-10 concentration exceeds the ceiling, and
# refuses outright when concentration could not be measured at all. Those two
# refusals are 33% and 67% of its rejections respectively, so the measurement
# matters more than the threshold does.
#
# Which measurement the gate uses:
#   provider      what the configured market-data provider reports. For
#                 MARKET_DATA_PROVIDER=free that is RugCheck's wallet-based
#                 figure; for dexscreener it is the RAW chain figure, which
#                 counts the AMM pool as a holder. These are NOT the same
#                 quantity -- that is exactly why the setting below exists.
#   chain_wallet  computed from chain, counting only accounts owned by real
#                 wallets (pool vaults, bonding curves and burns removed).
#   chain_raw     computed from chain, counting all ten largest accounts.
#
# Leave this at 'provider' until you have run probe_holder_calibration.py and
# know the gap. The ceiling is calibrated against ONE definition; applying it
# to another silently changes what the gate has been screening for.
HOLDER_CONCENTRATION_SOURCE=provider

# Measure from chain even when the gate is not using it, so the comparison
# accumulates on the tokens this agent actually evaluates (recorded in
# paper_trades.holder_pct_chain_*). Costs ~4 RPC calls per evaluated token --
# fine on a paid endpoint, too much on the keyless public one.
HOLDER_CONCENTRATION_OBSERVE=true

# The ceiling itself. Change it only together with the definition above.
TOP10_CONCENTRATION_CEILING_PERCENT=30.0

# Required only when MARKET_DATA_PROVIDER=gmgn. Get one at
# https://gmgn.ai/ai. For this read-only use you need ONLY the API key --
# when their setup offers to generate a request-signing keypair or bind a
# wallet for trading, skip it; you don't need it and it widens your blast
# radius for no benefit.
GMGN_API_KEY=

# Optional GMGN tuning. The hot-searches ranking is a global top-N list
# (there is no per-token heat lookup), so it's fetched once and cached
# across many token evaluations.
GMGN_HOT_SEARCH_INTERVAL=1h
GMGN_HOT_SEARCH_CACHE_TTL_S=300
GMGN_HOT_SEARCH_LIMIT=500

# --- Stage 3: real signing (see STAGE3_SETUP.md) --------------------------
#
# This app never touches a wallet, holds a key, or signs anything unless
# ENABLE_STAGE3_EXECUTION is explicitly set to "true" below AND the
# separate "signer" service has been configured and started (it does not
# start with a plain "docker compose up" -- see STAGE3_SETUP.md). No
# Turnkey credentials belong in THIS file -- those go in
# signer_service/.env instead, a deliberately separate file the "web"
# service never reads. Leave both of these as-is until you've completed
# STAGE3_SETUP.md's devnet smoke test yourself.
ENABLE_STAGE3_EXECUTION=false

# Internal Docker-network URL of the signer service -- the default below
# is correct for the docker-compose.yml as shipped and should not need
# changing.
SIGNER_SERVICE_URL=http://signer:8100

# --- Stage 2: paper trading (no money, no wallet, no signing) -------------
#
# The paper-trading experiment records EVERY evaluated token -- approved and
# rejected -- and marks both against real prices. Its whole purpose is to
# find out whether the pipeline's hand-chosen gate thresholds have any edge.
# Nothing here can place an order.

# Round-trip DEX fee charged per side. Solana AMM fees are commonly
# 0.25-1%; the default sits at the low end so the experiment can't be
# accused of being rigged pessimistic. Raise it to be stricter.
PAPER_FEE_PERCENT_PER_SIDE=0.25

# How long a LIMIT candidate waits for its 7% pullback before being written
# off as never-filled. Letting these wait forever would bias the sample
# toward tokens that eventually crashed into the trigger.
LIMIT_FILL_WINDOW_MINUTES=60

# Positions that neither hit target nor stop are closed at market after
# this long, so every trade eventually produces a measurable result.
PAPER_MAX_HOLD_MINUTES=360

# After a token's paper trade resolves, how long before that token may be
# recorded again. This is what stops one coin from being re-recorded on
# every tick: without it a single token becomes hundreds of overlapping
# trades sharing one price path, which inflates the sample size and makes a
# handful of coins look like a statistically meaningful result.
PAPER_REENTRY_COOLDOWN_MINUTES=60

# Elapsed times (minutes) at which each evaluated token's ACTUAL return is
# recorded, independently of the 7%/14% barriers.
#
# Why this second measurement exists: with a target at +7% and a stop at
# -14%, a driftless random walk hits the target first 14/(7+14) = 66.7% of
# the time, and the gross expected value is therefore exactly zero. A high
# win rate is the DEFAULT outcome there, not evidence of anything, and
# distinguishing a real 75% from that 66.7% baseline needs roughly 460
# independent tokens per cohort. Fixed-horizon returns use the magnitude of
# each move instead of a win/lose bit, so they reach a verdict on far fewer
# tokens -- and they don't depend on the 7%/14% levels being correct, which
# is important, because those levels are unvalidated guesses.
PAPER_HORIZONS_MINUTES=30,60,120

# A mark can only be taken on a tick, so a token that stops pricing gets its
# mark late. Marks later than this multiple of their horizon are still
# recorded but excluded from the summary: a price fetched 50 minutes late
# does not describe a 30-minute return.
PAPER_HORIZON_TOLERANCE=1.5

# --- Stage 2: short-window features (recorded, never gated on) -----------
#
# m5 is the finest bucket DexScreener publishes -- there is nothing below
# five minutes. That is not a limitation worth working around: a token doing
# 50 trades an hour has no trades at all in most 10-second windows, so a
# shorter window is mostly measuring emptiness. A signal is also a
# commitment to react on its timescale, and between the tick loop,
# DexScreener's caching, Jupiter quoting and ~400ms blocks, anything
# sub-minute belongs to bots we would be trading against, not alongside.
#
# The m5 fields cost nothing extra -- they arrive in the same response the
# price comes from -- and they exist so paper_trading.feature_correlations()
# can test whether they predict the horizon returns BEFORE any gate depends
# on them. There is no setting here to turn them on; they are always
# recorded and never acted upon.

# Minimum observations before a correlation is worth reading. Below this,
# |rho| of 0.3 turns up by chance often enough to mislead.
# (Set in paper_trading.MIN_CORRELATION_N; listed here for visibility.)

# --- Display timezone -----------------------------------------------------
#
# Which zone the dashboard clock and log lines are rendered in. Any IANA zone
# name. Use a region name (America/New_York), not a fixed offset or
# abbreviation: America/New_York switches between EDT (UTC-4) and EST (UTC-5)
# on the correct dates by itself, whereas a fixed -5 would be an hour wrong
# for roughly eight months of the year.
#
# DISPLAY ONLY. Every timestamp column is TIMESTAMP WITH TIME ZONE, so stored
# instants are absolute and changing this cannot reinterpret existing rows.
# Storing local wall-clock time instead would be actively unsafe here: Eastern
# repeats the 01:00-02:00 hour every November, so two different instants would
# share one timestamp -- and "which of these trades came first" is not a
# question a ledger should have to guess at.
#
# docker-compose.yml feeds this to TZ (the OS clock, for log lines) and PGTZ
# (so `docker compose exec db psql` prints the same zone the dashboard shows).
APP_TIMEZONE=America/New_York

# How long a paper trade may go WITHOUT A PRICE before it is abandoned.
#
# This closes a silent, one-directional bias. Both terminal checks in
# mark_to_market() sat downstream of "if the price is unknown, skip", so a
# trade whose token stopped pricing could never reach ANY end state -- it
# stayed OPEN forever, and results_summary() reads only CLOSED trades.
#
# The tokens that stop pricing are not a random sample. A delisted pair, a
# pulled pool, a rug -- those are the WORST outcomes in the population, and
# they were exactly the ones excluded from every average. Reported P&L was
# biased upward by an unknown amount, invisibly.
#
# Abandoned trades are recorded with status ABANDONED and NO fabricated exit
# price. They are excluded from the P&L averages and counted separately, so
# the dropout is visible rather than silent -- section 3b of stage2_check.sql.
PAPER_UNPRICEABLE_ABANDON_MINUTES=180

# --- Birdeye (read-only market data) --------------------------------------
#
# Replaces GeckoTerminal for token discovery. GeckoTerminal's free tier
# answered 429 from roughly the sixth call in a burst, which silently deleted
# whichever source was last in line -- see GECKOTERMINAL_MIN_INTERVAL_S below
# for the full story.
#
# Birdeye is a better fit for two concrete reasons, not just a higher limit:
#   - /defi/v3/token/list filters by min_liquidity SERVER-SIDE and returns up
#     to 100 rows per call, so a four-page walk plus client-side rejection of
#     ~90% of rows becomes one request that returns only what qualifies.
#   - /defi/v2/tokens/new_listing takes `time_to`, so recency paging walks
#     backwards through real timestamps instead of trusting that `page=N` is
#     honoured at all.
#
# Auth is an X-API-KEY header. Read-only: no signing key, no wallet, no
# custody -- same standing as every other provider here.
#
# 60 requests/minute is enforced PER SECOND, so there is no burst allowance.
# Budget per refresh is 4-5 calls; the throttle handles the spacing.
BIRDEYE_API_KEY=
BIRDEYE_API_BASE=https://public-api.birdeye.so

# --- Triton One (read-only Solana RPC) ------------------------------------
#
# NOT a discovery source. Triton has no trending or new-listing endpoint --
# it is Solana RPC infrastructure: standard JSON-RPC, Dragon's Mouth
# (Yellowstone) gRPC streaming, and a historical archive back to genesis.
# It cannot slot in beside Birdeye as a peer.
#
# What it offers is the layer underneath every aggregator. Price, liquidity
# and holder concentration all reach the gates as some vendor's
# INTERPRETATION of chain state, and two vendors are already known to
# disagree by 94.6% on at least one live token, with nothing in the system
# able to say which is right. Triton reads the chain.
#
# Under evaluation, not wired into the pipeline. probe_triton.py compares
# top-10 holder concentration computed from chain against RugCheck's figure
# for the same mint -- that number is F_ATLAS's input, so a material gap
# means a money gate is deciding on a figure that depends on which vendor
# was asked.
#
# Dragon's Mouth gRPC is the part that would change DISCOVERY rather than
# verification: transactions filtered by account_include surface a new pool
# within a slot (~400ms) instead of waiting for an aggregator to index it.
# That needs proto stubs and a persistent connection, so it is a separate
# build and deliberately not started.
#
# Set whichever form Triton issued -- URL with the token in the path, or a
# hostname plus an x-token header. Read-only: no signing key, no wallet.
TRITON_RPC_URL=
TRITON_X_TOKEN=

# --- Discovery sources ----------------------------------------------------
#
# HOW THIS GOT HERE, SO THE REASONING IS NOT RE-DERIVED
# Stage 2 plateaued: after ~18 hours the experiment had seen 50 distinct
# tokens and stopped finding new ones. The cause was not a bug -- all three
# original sources were POPULARITY rankings, and popularity is sticky over
# hours by definition, so they returned the same ~34 tokens every refresh.
#
# Widening to a paginated pool walk lifted it to 121 distinct in one hour and
# then flattened again at ~1.5 new tokens/hour, because pool volume rankings
# are also rankings of the already-established. A new-pools feed was added
# with an in-memory holding pen -- capture, age, release -- which worked, at
# the cost of ~150 lines of state that emptied on every restart, and of
# GeckoTerminal 429s that silently deleted whichever source ran last.
#
# Birdeye replaced all of that because it answers "recent AND liquid" in one
# question. The pen became a filter over one response. Measured: ~10
# qualifying listings/hour at a $25,000 floor -- 240/day against the 36/day
# the pool walk managed.
#
# Birdeye is PRIMARY; GeckoTerminal is kept as a keyless fallback.

# Rows per Birdeye page. 100 is the documented maximum, and one page of
# recency-sorted rows was measured reaching back ~10 hours -- so the
# evaluation window sits inside a single call with ~8x headroom and paging
# adds nothing. token_discovery logs a WARNING if that headroom is ever lost.
BIRDEYE_PAGE_LIMIT=100

# Liquidity floor, applied server-side by min_liquidity so ~90% of rows are
# never transferred at all.
#
# SAMPLING FRAME, NOT A GATE. This decides which launches are in the
# experiment -- the job "trending" does for the other sources. Measured
# distribution of new listings: ~85% clear $1,000, ~27% clear $2,500, ~12%
# clear $5,000, ~5% clear $25,000, with the mass in a tight band near $2.2k
# (a launchpad seeding pools with a standard amount, not a natural curve).
#
# MIND THE UNITS. This is pool liquidity -- TVL, both sides. B_SENTINEL judges
# tradeable depth, which is min(TVL / 2, reported one-sided), so its $20,000
# bar sits near $40,000 of LIQUIDITY. $25,000 is at most ~$12,500 of depth:
# nothing admitted here clears the gate when it is seen. What decides approval
# is whether liquidity grows during the age hold -- precisely the uncertainty
# worth an evaluation slot, with both verdicts reachable for every token.
#
# Do NOT raise to $40,000+. At or above the gate's own level approval becomes
# a tautology and this source's REJECTED arm disappears. Do not drop toward
# the $2.2k band either: those are pre-destined for REJECTED-for-depth, and
# the control arm is already ~5x the approved arm. Both ends are pinned by
# tests/test_discovery.py [FRAME].
BIRDEYE_MIN_LIQUIDITY_USD=25000

# Lower bound of the evaluation window: how old a listing must be before it
# may be evaluated. The one part of the deleted holding pen that was never
# optional -- a token listed seconds ago has no price at any provider, so
# record_candidate() drops it at `price <= 0` and one of ~190 hourly
# evaluation slots produces nothing.
BIRDEYE_MIN_AGE_MINUTES=15

# Upper bound. The sampler draws uniformly, so a token needs to sit in the
# list a while to be drawn at all: ~190 draws/hour over a ~220-token list
# gives each arrival roughly an 83% chance across a 75-minute window.
# Widening to 165 minutes reaches ~97% but recovers only ~1.4 tokens/hour and
# triples the spread of age-at-evaluation, adding variance to the measurement
# this is meant to sharpen. The tight window is deliberate.
BIRDEYE_MAX_AGE_MINUTES=90

# Minimum gap between two calls to the SAME provider, across every source.
#
# Rate limits belong to the vendor, not the calling function. Spacing pages
# WITHIN each source is not rate limiting and does not prevent 429s -- that
# was tried at 1.2s and failed, because three sources shared GeckoTerminal and
# nine calls still burst in ~12 seconds. 429s began at the sixth, and since a
# failed page ends a walk, the last source in line was deleted from the cycle
# while every log line looked healthy.
#
# Birdeye's 60/minute is enforced per second with no burst allowance.
BIRDEYE_MIN_INTERVAL_S=1.1
GECKOTERMINAL_MIN_INTERVAL_S=2.5

# GeckoTerminal pool walk. FALLBACK ONLY -- it runs when Birdeye contributes
# nothing at all (missing key, exhausted quota, vendor outage). Kept rather
# than deleted because it is the only breadth source needing no API key, and a
# fallback is worth having. GeckoTerminal's trending call still runs every
# cycle: a fallback path that is never exercised is one that does not work, so
# a live call every three minutes is how we learn it has broken.
DISCOVERY_POOL_PAGES=4

# Courtesy spacing between paginated calls within one source. NOT a
# rate-limit control -- see the per-provider intervals above.
DISCOVERY_PAGE_SPACING_S=0.4

# --- Stage 3: real signing (see STAGE3_SETUP.md) --------------------------
#
# This app never touches a wallet, holds a key, or signs anything unless
# ENABLE_STAGE3_EXECUTION is explicitly set to "true" below AND the
# separate "signer" service has been configured and started (it does not
# start with a plain "docker compose up" -- see STAGE3_SETUP.md). No
# Turnkey credentials belong in THIS file -- those go in
# signer_service/.env instead, a deliberately separate file the "web"
# service never reads. Leave both of these as-is until you've completed
# STAGE3_SETUP.md's devnet smoke test yourself.
# ENABLE_STAGE3_EXECUTION=false    <- DUPLICATE of line 178; set it THERE. Compose takes the LAST definition, so a value filled in above would be silently overridden by this one.

# Internal Docker-network URL of the signer service -- the default below
# is correct for the docker-compose.yml as shipped and should not need
# changing.
# SIGNER_SERVICE_URL=http://signer:8100    <- DUPLICATE of line 183; set it THERE. Compose takes the LAST definition, so a value filled in above would be silently overridden by this one.

